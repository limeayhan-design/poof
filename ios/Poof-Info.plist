<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.atlas.link.poof</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>poof</string>
			</array>
		</dict>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Scan a QR code to pair with another Poof device.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Poof discovers your server and nearby Poof devices on your Wi-Fi.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_poof._tcp</string>
		<string>_poof-offline._tcp</string>
		<string>_poof-offline._udp</string>
		<string>_poof-pair._tcp</string>
		<string>_poof-pair._udp</string>
	</array>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Poof uses Bluetooth to send files offline to nearby devices without an internet connection.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Poof uses Bluetooth to broadcast your device to nearby recipients when offline.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Save received photos and videos to your library.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Poof needs Photos access to save received files, and to remove saved copies when a Secure send expires.</string>
	<key>NSContactsUsageDescription</key>
	<string>Poof uses your Me card photo to personalise the cloud avatar in the top-right of the app.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Poof uses Face ID to unlock Secure files you receive with biometric protection.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
