<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.atlas.link.poof</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>poof</string>
			</array>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Poof connects to your signaling server and nearby Poof devices on your Wi-Fi.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_poof._tcp</string>
		<string>_poof-offline._tcp</string>
		<string>_poof-offline._udp</string>
		<string>_poof-pair._tcp</string>
		<string>_poof-pair._udp</string>
	</array>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Poof uses Bluetooth to send files offline to nearby devices without an internet connection.</string>
	<key>NSCameraUsageDescription</key>
	<string>Poof uses the camera to scan pairing QR codes from your other devices.</string>
	<key>NSContactsUsageDescription</key>
	<string>Poof uses your Me card photo to personalise the cloud avatar in the top-right of the app.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Poof uses Touch ID / Face ID to unlock Secure files you receive with biometric protection.</string>
</dict>
</plist>
